# -----------------------------------------------------------------------------
# AVENIX - ENVIRONMENT CONFIGURATION TEMPLATE
# -----------------------------------------------------------------------------
# Copia este archivo como .env y rellena los valores correspondientes.
# NUNCA subas credenciales reales al repositorio.

# Configuración de la aplicación
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos (PostgreSQL / Neon Database)
# Utiliza sslmode=require para conexiones seguras con Neon
DATABASE_URL="postgresql://username:password@ep-unique-id.eu-central-1.aws.neon.tech/avenix_db?sslmode=require"
# En caso de utilizar Prisma con Neon connection pooling, define DIRECT_URL para migraciones:
DIRECT_URL="postgresql://username:password@ep-unique-id.eu-central-1.aws.neon.tech/avenix_db?sslmode=require"

# Seguridad y Autenticación
# Generar una clave segura con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-una-clave-secreta-aleatoria-de-minimo-32-caracteres"
JWT_SECRET="cambia-esto-por-otro-token-secreto-para-firmar-jwt"

# Inicialización segura de Administrador
# Token requerido para el endpoint o script de creación del primer superadmin (evita credenciales por defecto)
ADMIN_INITIAL_SETUP_TOKEN="clave-secreta-para-inicializar-primer-administrador"

# Stripe (Pasarela de pagos y suscripciones)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Discord Official Bot Credentials (compartidas con C:\Users\romer\OneDrive\Avenix Bot)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
NEXT_PUBLIC_BOT_INVITE_URL="https://discord.com/oauth2/authorize?client_id=TU_CLIENT_ID&scope=bot+applications.commands&permissions=8"

# Integración con el Servicio de Avenix Bot (apps/bot en puerto 4000)
AVENIX_BOT_PATH="C:\\Users\\romer\\OneDrive\\Avenix Bot"
AVENIX_BOT_API_URL="http://localhost:4000"
INTERNAL_API_SECRET="clave-compartida-con-avenix-bot"

# Notificaciones y Soporte
ADMIN_NOTIFICATION_EMAIL="contacto@avenix.dev"
RESEND_API_KEY="" # Opcional para envío transaccional de emails
